<IfModule mod_dir.c>
    DirectoryIndex index.php index.html
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # La racine est un dossier : il faut la forcer vers index.php
    RewriteRule ^$ index.php [L]

    RewriteRule (^|/)\.git - [F,L]
    RewriteRule ^(src|resources|storage|vendor)/ - [F,L]
    RewriteRule ^(composer\.(json|lock)|install\.php)$ - [F,L]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(src|resources|storage|vendor)/ - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . index.php [QSA,L]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|webp|woff2|ico|svg|mp4)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "^(\.env.*|install\.php|composer\.(json|lock))$">
        Require all denied
    </FilesMatch>
</IfModule>
