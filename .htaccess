<IfModule mod_dir.c>
    DirectoryIndex index.php index.html
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # La racine est un dossier : il faut la forcer vers index.php
    RewriteRule ^$ index.php [L]

    RewriteRule (^|/)\.git - [F,L]
    RewriteRule ^(src|resources|storage|vendor)/ - [F,L]
    RewriteRule ^(composer\.(json|lock)|install\.php)$ - [F,L]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(src|resources|storage|vendor)/ - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . index.php [QSA,L]
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "^(\.env.*|install\.php|composer\.(json|lock))$">
        Require all denied
    </FilesMatch>
</IfModule>
